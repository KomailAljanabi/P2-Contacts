<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png"
        href="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcScoXNTbe33bi6hDXFIBOO7T2dRE3G35pMP4MXCkw_9lg&s"
        class="tab-favicon">
</head>

<body>
    <%- include('../partials/header')%>

        <main class="main-content auth-layout">
            <div class="auth-card">
                <div class="auth-header">
                    <h2>Welcome Back</h2>
                    <p>Sign in to your organization contact workspace</p>
                </div>

                <form action="/auth/sign-in" method="POST" class="auth-form">
                    <div class="form-group">
                        <label for="Username">Username</label>
                        <div class="input-with-icon">
                            <i class="fa-solid fa-envelope"></i>
                            <input type="text" id="Username" name="username" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="label-row">
                            <label for="password">Password</label>
                        </div>
                        <div class="input-with-icon">
                            <i class="fa-solid fa-lock"></i>
                            <input type="password" id="password" minlength="8" name="password" required>
                        </div>
                    </div>

                    <div class="form-row flex-between">
                        <label class="checkbox-container">
                            <input type="checkbox" name="remember" value="true">
                            <span class="checkmark"></span>
                            Remember me on this device
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block btn-lg">
                        <i class="fa-solid fa-right-to-bracket mr-2"></i> Sign In
                    </button>
                </form>

                <div class="auth-footer-text">
                    Don't have an account yet? <a href="/auth/sign-up">Create an account</a>
                </div>
            </div>
        </main>

        <%- include('../partials/footer') %>
</body>

</html>