<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Resource Not Found</title>
    <link rel="icon" type="image/png"
        href="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcScoXNTbe33bi6hDXFIBOO7T2dRE3G35pMP4MXCkw_9lg&s"
        class="tab-favicon">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/header') %>
        <main class="main-content auth-layout">
            <div class="main-container">
                <div class="empty-state-card">
                    <h1 class="page-title">404</h1>
                    <h2 class="page-subtitle mt-3">Connection Lost</h2>
                    <p class="text-muted mt-3">The requested resource at <strong>
                            <%= requestedUrl %>
                        </strong> could not be found on this server.</p>
                    <div class="mt-3">
                        <a href="/" class="btn btn-primary mr-2">Return Home</a>
                    </div>
                </div>
            </div>
        </main>
        <%- include('partials/footer') %>
</body>

</html>